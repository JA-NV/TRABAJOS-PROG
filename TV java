public class TV {
    
    String marca;
    int pulgadas;
    boolean encendido;
    int volumen;

    
    public TV() {
        this.encendido = false; 
        this.volumen = 10;      
    }

    
    public void encender() {
        this.encendido = true;
        System.out.println("La TV se esta encendiendo...");
    }

    public void apagar() {
        this.encendido = false;
        System.out.println("La TV se esta apagando...");
    }

    public void subirVolumen() {
        if (encendido) {
            this.volumen++;
            System.out.println("Subiendo el volumen..." + this.volumen);
        } else {
            System.out.println("No se puede subir el volumen, TV apagada.");
        }
    }

    public void bajarVolumen() {
        if (encendido && this.volumen > 0) {
            this.volumen--;
            System.out.println("Bajando el volumen..." + this.volumen);
        } else if (!encendido) {
            System.out.println("No se puede bajar el volumen, TV apagada.");
        } else {
            System.out.println(" Volumen ya al mínimo.");
        }
    }
    
}
